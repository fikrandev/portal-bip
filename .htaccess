# Portal BIP - Apache Rewrite Rules
# All requests are routed through index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # RewriteBase is intentionally omitted so it adapts automatically to root or any subfolder

    # Skip rewriting for real files and directories
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Route everything else to index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Security: Deny access to sensitive files
<FilesMatch "\.(php|sql|log|md|env.*)$">
    # Allow only index.php
</FilesMatch>

# Deny access to hidden files and directories (like .git, .env)
<IfModule mod_rewrite.c>
    RewriteRule (^|/)\.(?!well-known) - [F]
</IfModule>

# Deny access to sensitive directories (while keeping storage/uploads accessible)
<IfModule mod_rewrite.c>
    RewriteRule ^(core|config|database|templates)/ - [F,L]
    RewriteRule ^storage/(logs|cache)/ - [F,L]
</IfModule>

# Enable Gzip Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Browser Caching for Static Assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
</IfModule>
